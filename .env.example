# Sanity
# Find your project ID in https://sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Public site URL — used by the embedded Studio's Presentation tool
# and by stega encoding to wire visual editing back to /admin.
# Override per environment (e.g. https://example.com in production).
PUBLIC_SITE_URL=http://localhost:4321

# Server-only token with Viewer permissions. Required for visual editing
# (read draft content). Create at https://sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=
