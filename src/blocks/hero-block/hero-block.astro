---
import { urlFor } from "@/cms/image";
import type { Hero } from "@/cms/sanity.types";
import { Container, Grid, Section } from "@/components/core";
import GridLines from "@/components/misc/grid-lines.astro";

interface Props {
    data: Hero;
}

const { data } = Astro.props;
const { _type, theme, title, image, excerpt } = data;

const imageSrc = image?.asset ? urlFor(image).width(1600).auto("format").url() : null;
const imageAlt = image?.alt ?? title ?? "";
---

<Section class='h-svh py-grid-margin! overflow-clip' {_type} {theme} data-hero-block>
    <GridLines />
    <Container class='h-full'>
        <Grid class='h-full grid-rows-[1fr_auto]'>
            <h1
                class='hero-headline col-span-full self-start text-h1'
                style='font-size: clamp(2.5rem, 13vw, 20rem)'
                aria-label={title}
                data-text-reveal='lines'
                data-from='top'
                data-entrance-delay='0.5'
            >
                {title}
            </h1>
            <div class='relative self-end col-span-full'>
                <p
                    class='absolute left-0 bottom-0 w-full max-w-md text-xs uppercase text-balance'
                    data-text-reveal='lines'
                    data-from='top'
                    data-delay='0.5'
                    data-entrance-delay='0.5'
                >
                    {excerpt}
                </p>
                <div class='relative w-fit' data-hero-block-image>
                    {
                        imageSrc && (
                            <img
                                src={imageSrc}
                                alt={imageAlt}
                                loading='lazy'
                                decoding='async'
                                data-image-reveal
                                class='max-h-[50vh] h-full w-auto object-cover'
                                data-entrance-delay='0.5'
                            />
                        )
                    }
                </div>
            </div>
        </Grid>
    </Container>
</Section>
