---
import { urlFor } from "@/cms/image";
import type { Hero } from "@/cms/sanity.types";
import { Container, Grid, Section } from "@/components/core";
import GridLines from "@/components/misc/grid-lines.astro";

interface Props {
    data: Hero;
}

const { data } = Astro.props;
const { _type, theme, title, image } = data;

const imageSrc = image?.asset ? urlFor(image).width(1600).auto("format").url() : null;
const imageAlt = image?.alt ?? title ?? "";
---

<Section class='h-svh py-grid-margin! overflow-clip' {_type} {theme} data-hero-block>
    <GridLines />
    <Container class='h-full'>
        <Grid class='h-full grid-rows-[1fr_auto]'>
            <h1 class='hero-headline col-span-full self-start text-h1' style='font-size: clamp(2.5rem, 13vw, 20rem)' aria-label={title} data-text-reveal='lines' data-from='top'>
                {title}
            </h1>
            <div class='relative self-end col-span-full'>
                <div class='relative w-fit' data-hero-block-image>
                    {imageSrc && <img src={imageSrc} alt={imageAlt} loading='lazy' decoding='async' data-image-reveal class='max-h-[50vh] h-full w-auto object-cover' />}
                </div>
            </div>
        </Grid>
    </Container>
</Section>
