---
import { RenderBlocks } from "@/blocks";
import { groq } from "@/cms/queries";
import { loadQuery } from "@/cms/load-query";
import { getDraftModeProps } from "@/cms/draft-mode";
import { Base } from "@/components/layout";
import type { PageBySlugQueryResult } from "@/cms/sanity.types";

const slugParam = Astro.params.slug;
const slug = !slugParam || slugParam === "" ? "home" : slugParam;

const { data: page } = await loadQuery<PageBySlugQueryResult>({
    query: groq.page.bySlug,
    params: { slug },
    ...getDraftModeProps(Astro.cookies),
});

if (!page) return Astro.redirect("/404");
---

<Base title={page.title}>
    <RenderBlocks sections={page.content} />
</Base>
