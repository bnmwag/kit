---
import "@/styles/main.css";

import { Font } from "astro:assets";
import { Footer, Navigation } from "@/components/layout";
import { isDraftModeActive } from "@/cms/draft-mode";
import SanityVisualEditing from "@/components/sanity/sanity-visual-editing";
import DisableDraftMode from "@/components/sanity/disable-draft-mode";

interface Props {
  title?: string;
  description?: string;
  scrollOrientation?: string;
}

const { scrollOrientation = "vertical", title = "Kit", description } = Astro.props;
const draftMode = isDraftModeActive(Astro.cookies);
---

<!doctype html>
<html lang='en' data-scroll-orientation-settings={scrollOrientation}>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='generator' content={Astro.generator} />
    <Font cssVariable='--font-zalando-sans' preload />
    <Font cssVariable='--font-jetbrains-mono' preload />
    <title>{title}</title>
    {description && <meta name='description' content={description} />}
  </head>
  <body class='font-sans antialiased'>
    <Navigation />
    <main id='swup' data-swup-transition>
      <slot />
    </main>
    <Footer />

    {draftMode && (
      <>
        <SanityVisualEditing client:only='react' />
        <DisableDraftMode client:only='react' />
      </>
    )}

    <script>
      import "@/scripts/app";
    </script>
  </body>
</html>
