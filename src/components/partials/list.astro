---
interface IListItem {
  title: string;
  description: string;
  url?: string;
}

interface Props {
  items: readonly IListItem[];
  classes?: string;
  modifiers?: string;
  link?: boolean;
}

const { items, classes, modifiers, link = false } = Astro.props;
---

<div class:list={["c-list", modifiers, classes]} data-scroll>
  <ul class="c-list_inner">
    {
      items.map((item, index) => (
        <li class="c-list_item | c-text -body-regular" style={`--index: ${index}`}>
          {link ? (
            <a
              class="c-list_item_inner u-hover-underline"
              href={item.url}
              target="_blank"
              data-module-hover-shuffle
              data-hover-shuffle="children"
            >
              <span class="c-list_title || c-text -body-regular" data-hover-shuffle-child>
                {item.title}
              </span>
              <span class="c-list_description || c-text -body-regular" data-hover-shuffle-child>
                {item.description}
              </span>
              <span class="c-list-anchor">↗</span>
            </a>
          ) : (
            <div class="c-list_item_inner">
              <p class="c-list_title || c-text -body-regular">{item.title}</p>
              <p class="c-list_description || c-text -body-regular">{item.description}</p>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</div>
