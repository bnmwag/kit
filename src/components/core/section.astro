---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
    _type: string;
    theme: "light" | "dark" | "accent" | undefined;
}

const { class: className, _type, theme, ...props } = Astro.props;
---

<section
    data-block={_type}
    class={`relative bg-background text-foreground py-16 lg:py-[17vh] ${className ?? ""} theme-${theme}`}
    {...props}
>
    <slot />
</section>
